# Copy this file to .env and fill in your keys
USE_OPENAI=false
OPENAI_API_KEY=your_key_here
GEMINI_API_KEY=your_gemini_key_here   # Get free at: https://aistudio.google.com/apikey
SERP_API_KEY=your_key_here

# Local Infrastructure Defaults
BROKER_URL=filesystem://
RESULT_BACKEND=db+sqlite:///./celery_results.db
DATABASE_URL=sqlite:///./jobs.db

# Enterprise Security (Optional)
# UNLEASH_API_TOKEN=change_me_to_a_strong_secret
# UNLEASH_CORS_ORIGINS=http://127.0.0.1:8001,http://localhost:8001
